# Engineering Flow Platform Configuration Template
# COPY THIS FILE TO config.yaml AND FILL IN YOUR VALUES!

# ============================================
# Portal-Managed Configuration
# ============================================
# This file is the read-only base configuration. On Kubernetes, Portal-managed
# runtime-profile values (credentials, tool settings, runtime fields) arrive
# via the EFP_PROFILE_CONFIG environment variable at pod start and are merged
# in memory; this file is never rewritten. Encrypted ENC: values and
# EFP_CONFIG_KEY are no longer supported.

# ============================================
# LLM Configuration (REQUIRED)
# ============================================
llm:
  # EFP runtime native mode supports GitHub Copilot and AI Platform.
  # Accepted aliases: github_copilot, github-copilot, copilot,
  # ai_platform, ai-platform
  provider: "github_copilot"
  # Optional override. Blank lets EFP use the exchanged Copilot token proxy-ep
  # when present, otherwise https://api.githubcopilot.com.
  api_base: ""
  # GitHub source tokens are exchanged for Copilot plugin tokens automatically.
  # If EFP_GITHUB_COPILOT_TOKEN/GITHUB_COPILOT_TOKEN is already a Copilot token,
  # EFP uses it directly.
  api_key: "ghp_YOUR_GITHUB_TOKEN"
  model: "gpt-5.6-terra"
  reasoning_effort: "high"

  # AI Platform (provider: ai_platform). The Portal-managed runtime profile
  # supplies chat/ib2b/auth; an optional Responses endpoint takes precedence
  # over chat/completions when its uri is set (host defaults to chat.host).
  # ai_platform:
  #   chat:
  #     host: "https://<gateway-host>"
  #     uri: "/v1/api/v1/chat/completions"
  #   responses:
  #     uri: "/v1/<use-case-id>/responses"
  #   ib2b:
  #     host: "https://<ib2b-host>"
  #     uri: "/dsp/token"
  #   auth:
  #     username: ""
  #     password: ""
  #     usercase: ""

  max_tokens: 128000
  allow_lower_max_tokens_than_model_limit: false
  model_limits:
    gpt-5.4:
      max_context_window_tokens: 400000
      max_prompt_tokens: 272000
      max_output_tokens: 128000
    gpt-5.5:
      max_context_window_tokens: 400000
      max_prompt_tokens: 272000
      max_output_tokens: 128000
    gpt-5.6-luna:
      max_context_window_tokens: 328000
      max_prompt_tokens: 200000
      max_output_tokens: 128000
    gpt-5.6-sol:
      max_context_window_tokens: 400000
      max_prompt_tokens: 272000
      max_output_tokens: 128000
    gpt-5.6-terra:
      max_context_window_tokens: 400000
      max_prompt_tokens: 272000
      max_output_tokens: 128000
  temperature: 0.7
  reasoning_replay: false
  max_retries: 3
  retry_delay: 1
  context_budget:
    default:
      max_prompt_tokens: 272000
      reserved_output_tokens: 128000
      safety_margin_tokens: 8000
    pre_request:
      max_prompt_tokens: 272000
      reserved_output_tokens: 128000
      safety_margin_tokens: 8000
    tool_loop:
      max_prompt_tokens: 272000
      reserved_output_tokens: 128000
      safety_margin_tokens: 8000
    skill_generation:
      max_prompt_tokens: 272000
      reserved_output_tokens: 128000
      safety_margin_tokens: 8000
    tool_loop_aggressive:
      max_prompt_tokens: 200000
      reserved_output_tokens: 128000
      safety_margin_tokens: 8000
  output_controller:
    max_chat_output_tokens: 120000
    chars_per_token_estimate: 4
    max_chat_output_chars: null
    oversized_output_strategy: "save_and_manifest"
  tool_loop:
    # Keep agent actions sequential: action -> observation -> next action.
    one_tool_per_turn: true
    # For provider transports that support it.
    parallel_tool_calls: false
    # Number of repeated identical tool/args/result patterns allowed before stopping.
    max_repeated_tool_signature: 2
  response_flow:
    # Direct completion is the default.
    plan_policy: "explicit_or_complex"
    staging_policy: "explicit_or_complex"
    default_skill_execution_style: "direct"
    ask_user_policy: "blocked_only"
    # direct active skill conflict policy:
    # - auto_switch_direct: clear new request leaves old direct skill automatically
    # - always_ask: keep active direct skill context and ask continue-vs-switch
    active_skill_conflict_policy: "auto_switch_direct"
    # Staging/planning activates only on explicit request or true budget pressure.
    complexity_prompt_budget_ratio: 0.85
    complexity_min_request_tokens: 24000
  context_projection:
    recent_protected_messages: 6
    jira_confluence:
      model_feedback_max_chars: 8000
      min_acceptance_criteria_chars: 3000
      comments_max_chars: 1500
      include_section_map: true
      persist_full_content: true
    old_assistant:
      max_chars: 6000
      artifact_like_max_chars: 3000
      summary_max_chars: 2000
      persist_full_content: true
    old_tool:
      max_chars: 8000
      preview_chars: 2000
      persist_full_content: true
  
  # Workspace instructions are stored in AGENTS.md under the configured
  # workspace. Edit it directly or through the Portal system prompt editor.

# ============================================
# Runtime Context Budget (OPTIONAL)
# ============================================
# These are TOP-LEVEL keys, not nested under `llm:`. They are the only
# context-budget knobs the native (efp_runtime) request path reads: they are
# lifted off the top level of the effective config by
# src/gateway/runtime_chat.py:_runtime_config_profile_kwargs, filtered by
# PORTAL_MANAGED_RUNTIME_FIELDS in src/config.py.
#
# Leave them unset and the budget is derived from the model catalog
# (src/efp_runtime/llm/models.py): the model's declared context window minus a
# safety margin, with the model's declared response reserve held back. That
# default is what keeps a long conversation from growing past the model window
# and returning `400 Bad Request / "Your input exceeds the context window"`.
#
# Set them only to override that default -- for example to pin a smaller
# prompt budget. They size the in-memory provider request ONLY; none of them
# touches the stored session. See `compaction_rewrite_stored_history` below.
#
# All three caps must be >= 1. `0` is rejected (the chat returns 400 naming the
# field) rather than silently meaning "unlimited" or "disabled" -- it used to
# produce a one-character budget, i.e. every request cut down to system context
# plus the latest turn. To turn a cap off, omit the key and inherit the
# model-catalog default.
#
# A value larger than the catalog PROMPT CEILING is clamped down to it. The
# ceiling is the declared window minus the safety margin -- 392000 tokens /
# 1568000 chars on a 400k model -- i.e. the same cap the unset path uses, NOT
# the declared window itself. So `max_context_tokens: 400000` on a 400k model
# is clamped to 392000 (a ~2% reduction): the margin absorbs the error in the
# 4-chars-per-token estimate, and without it a nominally exact value still
# reproduces the provider `400 / input exceeds the context window` this whole
# default exists to prevent. The clamp is reported in run metadata under
# `context_budget` as max_context_chars_clamped / _requested / _limit, so a
# clamp of that size is visible rather than silent.
#
# The clamp does NOT apply to a model id absent from
# src/efp_runtime/llm/models.py: an uncatalogued model falls back to a
# conservative 64k guess, and an override is the only way to correct that
# guess, so there the operator's value is honoured verbatim (_limit is null).
#
# Note the clamp bounds the CAP, not the final prompt: the two routes subtract
# different reserves (see below), so a clamped `max_context_tokens` lands on the
# same effective budget as leaving it unset, while a clamped `max_context_chars`
# keeps its zero reserve and so allows a larger prompt -- still inside the
# window, because the safety margin is what the ceiling holds back.
#
# These two are NOT the same knob and do not produce the same budget:
#
# max_context_tokens: 250000   # CONTEXT WINDOW, not prompt budget. The model's
#                              # declared response reserve is then subtracted
#                              # (clamped to half), so on a 400k/128k model this
#                              # yields ~125000 tokens of actual prompt.
# max_context_chars: 1000000   # PROMPT BUDGET directly. No model reserve is
#                              # subtracted -- only context_reserve_chars, which
#                              # defaults to 0. Wins over max_context_tokens.
#                              # 1000000 chars is ~250000 tokens at 4 chars/token.
# max_context_parts: 200       # cap on message parts, independent of the above
# context_reserve_tokens: 128000  # response headroom; overrides the model's own
#                              # reserve for BOTH of the above
#
# compaction_rewrite_stored_history: true
#   Rewrites the STORED session on disk -- the transcript the user reads in the
#   Portal -- whenever it exceeds the budget above. IRREVERSIBLE: the replaced
#   messages are gone. Off by default and NOT implied by any of the caps above;
#   setting a cap only shrinks the request that goes to the model, which is
#   already enough to stay inside the budget. Turn this on only if you also want
#   old turns removed from the stored conversation. (Manual /compact is
#   unaffected either way.) The state in force is reported in run metadata as
#   `context_budget.stored_history_rewrite`.
#
#   OPERATIONAL WARNING: with this off (the default), long-lived sessions grow
#   without bound on disk. Requests stay bounded -- the render-time compactor
#   handles that -- but nothing trims the stored session, and the file store
#   rewrites and re-parses the whole session file per turn, so turn latency
#   grows with session length. If you previously relied on a size cap to keep
#   stored sessions small, set this to `true` to keep that behaviour.
#
# NOTE: the `llm.context_budget` and `llm.model_limits` blocks above are read
# by the LEGACY progressive-context stack (src/runtime/progressive_context.py,
# src/config.py:resolve_model_limits), NOT by the native request path. Changing
# them will not resize a native runtime chat request.

# ============================================
# Session Configuration (OPTIONAL)
# ============================================
# Session persistence and caching settings
session:
  # In-memory session settings
  max_history: 5  # Keep last 5 conversation turns
  auto_save: true  # Automatically save sessions to disk

  # Optional maximum agentic steps; omit to keep the loop unbounded until the model stops
  # Alias-compatible with opencode-style `steps`.
  # max_iterations: 30

  # Persistence layer settings (per-session files)
  persistence:
    enabled: true  # Enable session persistence
    storage_dir: "/workspace/sessions"  # Where to store session files
    ttl_seconds: 2592000  # Session TTL in seconds (30 days = 30 * 24 * 3600)

  # Cache settings (for in-memory session cache)
  cache:
    enabled: true  # Enable session caching
    max_sessions: 1000  # Max sessions to keep in memory
    ttl_seconds: 3600  # Cache TTL in seconds (default: 1 hour)

# ============================================
# Cost Tracking Configuration (OPTIONAL)
# ============================================
# Track LLM usage and costs across providers

cost_tracking:
  enabled: true  # Enable cost tracking
  storage_dir: "~/.efp/usage"  # Where to store usage records
  retention_days: 30  # Keep records for N days (default: 30)
  # Model pricing can be customized here
  # By default uses built-in pricing from cost_tracker.py

# Example usage:
# cost_tracking:
#   enabled: true
#   storage_dir: "~/.efp/usage"
#   retention_days: 30

# EFP runtime native provider and common models:
# - github_copilot: gpt-5.4, gpt-5.5, gpt-5.6-luna, gpt-5.6-sol, gpt-5.6-terra (default: gpt-5.6-terra)

# ============================================
# Workspace Configuration (OPTIONAL)
# ============================================
# Workspace paths for project-specific files
# Defaults are under /workspace in the runtime container.

workspace:
  # Main workspace directory
  path: "/workspace"

  # Session storage (can be overridden in session config)
  sessions_dir: "/workspace/sessions"

# ============================================
# Session Storage Structure
# ============================================
# Session data is stored in /workspace/sessions/
#
# Structure:
#   /workspace/
#   |-- sessions/              Individual session files
#   |   |-- {sanitized_id}_{hash}.jsonl  (one file per session)
#   |   `-- archive/           Archived sessions
#
# Runtime workspace data is under /workspace by default.
# ============================================
# Server Configuration (OPTIONAL)
# ============================================
server:
  host: "0.0.0.0"  # Listen on all interfaces
  port: 8000       # Default port
  portal_internal_base_url: "https://portal.internal"  # Runtime -> Portal internal API base URL (adapter:portal:*)
  jira_reconciliation_enabled: false  # Enable scheduled Jira reconciliation -> Portal external event ingest
  jira_reconciliation_interval_seconds: 300  # Reconciliation polling interval

# ============================================
# Jira Configuration (OPTIONAL)
# ============================================
# Jira supports multiple authentication methods:
# 1. Bearer Token (recommended for Jira Cloud)
# 2. Basic Auth with API Token (recommended for Jira Server/DC)
# 3. Basic Auth with Password (legacy, not recommended)
#
# Runtime profile application projects Jira/Confluence values into the
# Atlassian CLI config used by the prebuilt `jira` and `confluence` binaries
# when those binaries are present on PATH. The old Python external tools loader
# (`EFP_TOOLS_DIR`, `EFP_EXTERNAL_TOOLS_*`) is not used.

# ============================================
# Jira Configuration (OPTIONAL) - Supports Multiple Instances
# ============================================
# Configure as array to support multiple Jira instances
jira:
  enabled: false  # Set to true to enable Jira integration
  # Multiple Jira instances - use array format
  instances:
    - name: "Default"  # Display name for this instance
      url: "https://your-domain.atlassian.net"
      project: "PROJECT"  # Default project key
      
      # --- Authentication Method 1: Bearer Token ---
      # token: "${JIRA_TOKEN}"
      
      # --- Authentication Method 2: Basic Auth (username + password) ---
      # username: "admin@company.com"
      # password: "${JIRA_PASSWORD}"
      
      # --- Advanced Options ---
      # api_version: "2" or "3" (default: 2)
      # timeout: 30.0

# ============================================
# Confluence Configuration (OPTIONAL) - Supports Multiple Instances
# ============================================
# Configure as array to support multiple Confluence instances
confluence:
  enabled: false  # Set to true to enable Confluence integration
  # Multiple Confluence instances - use array format
  instances:
    - name: "Default"  # Display name for this instance
      url: "https://your-domain.atlassian.net/wiki"
      username: ""
      password: "${CONFLUENCE_PASSWORD}"  # Use env var for security
      # token: "${CONFLUENCE_TOKEN}"  # Alternative: Bearer Token
      space: "DEV"  # Default space key

# ============================================
# GitHub Configuration (OPTIONAL)
# ============================================
github:
  enabled: false  # Set to true to enable GitHub integration
  api_token: "${GITHUB_TOKEN}"  # Used for GitHub REST API tools and Git-over-HTTPS auth (clone/push/pull)
  # Optional GitHub API base URL (leave blank to use https://api.github.com)
  # Enterprise example: https://github.company.com/api/v3
  base_url: ""

# ============================================
# Mention Polling Configuration (OPTIONAL)
# ============================================
# Monitor @mentions across platforms and process commands
polling:
  enabled: false  # Set to true to enable mention polling

  # Polling interval in seconds (default: 30)
  interval_seconds: 30

  # Usernames to monitor (the configured account usernames)
  # When someone @mentions these users, the bot will process commands
  monitored_usernames:
    - "your-github-username"
    - "your-jira-username"
    - "your-confluence-username"

  # GitHub polling settings
  github:
    enabled: false
    repos:  # Repositories to monitor
      - "owner/repo1"
      - "owner/repo2"

  # Jira polling settings
  jira:
    enabled: false
    projects:  # Projects to monitor
      - "PROJECT1"
      - "PROJECT2"

  # Confluence polling settings
  confluence:
    enabled: false
    spaces:  # Spaces to monitor
      - "DEV"
      - "DOCS"

# ============================================
# Git Configuration (OPTIONAL)
# ============================================
# Configure git user for commits
# These will be set via `git config --global` at startup

git:
  user:
    name: ""  # Git user name (e.g., "Engineering Flow Platform Bot")
    email: ""  # Git user email (e.g., "bot@company.com")

# Example usage:
# git:
#   user:
#     name: "Engineering Flow Platform Bot"
#     email: "bot@company.com"

# ============================================
# Heartbeat Configuration (OPTIONAL)
# ============================================
# Periodic background checks with thinking-level awareness
# The thinking level affects:
# - Check frequency: thinking=high (2x frequent), thinking=off (2x slower)
# - Detail level: thinking=high (detailed), thinking=off (simplified)

heartbeat:
  enabled: false  # Set to true to enable heartbeat checks
  check_interval: 300  # Base interval between checks in seconds (default: 5 minutes)

  # Example behavior:
  # - thinking=high: 2x more frequent (150s), detailed analysis
  # - thinking=off: 2x less frequent (600s), simplified checks

# Example usage:
# heartbeat:
#   enabled: true
#   check_interval: 300

# ============================================
# Debug Logging Configuration (OPTIONAL)
# ============================================
# Enable debug logging for troubleshooting
# Set log_level: DEBUG in logging configuration or use --debug flag

debug:
  enabled: false  # Set to true to enable debug logging
  # httpx_trace: Enable httpx detailed trace logging (very verbose)
  # When true, logs all HTTP request/response details including TLS, headers, body
  # Recommended: false - set to true only for network debugging
  httpx_trace: false  # Set to true to enable httpx trace logging

# Example usage:
# debug:
#   enabled: true

# What gets logged when enabled:
# - LLM requests: Model name, messages, tools
# - LLM responses: Content, reasoning, tool calls, usage
# - Agent processing: Messages, tool execution, final responses

# ============================================
# Built-in Tool Configuration
# ============================================
# Model-facing tools are the EFP runtime built-ins. The bash tool runs inside
# the configured workspace and is governed by runtime tool permissions; no old
# bash_tools package or Python tool loader configuration is supported.

# ============================================
# Error Logging Configuration
# ============================================
# Settings for error logging and display

error_logging:
  # Log full error details (including status codes, response bodies)
  # Recommended: true for debugging, false for production
  log_full_errors: true

  # Return error details to API clients
  # true: Include error type, details, timestamp in responses
  # false: Only return basic error message
  return_error_details: true

  # Sanitize sensitive data in error logs
  # Masks API keys, tokens, passwords
  sanitize_errors: true

# Example usage:
# error_logging:
#   log_full_errors: true
#   return_error_details: true
#   sanitize_errors: true

# ============================================
# Proxy Configuration (OPTIONAL)
# ============================================
# Configure HTTP/HTTPS proxy for outbound requests
# This will be applied to os.environ at startup

# Example usage:
# proxy:
#   enabled: true
#   url: "http://proxy.example.com:8080"
#   username: "user"
#   password: "password"
